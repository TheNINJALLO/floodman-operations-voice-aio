# Floodman Operations Voice AIO 1.1.1
APP_NAME=Floodman Operations Voice AIO
ENVIRONMENT=production
WEB_HOST=0.0.0.0
WEB_PORT=9000
# Docker publishes the dashboard only on loopback by default.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=9000
# Used by the optional docker-compose.caddy.yml HTTPS overlay.
VOICE_DOMAIN=voice.example.com
SIP_BIND_IP=0.0.0.0
PUBLIC_BASE_URL=https://voice.example.com
TRUSTED_HOSTS=voice.example.com,localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1
FORCE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
ENABLE_API_DOCS=false
PRINT_BOOTSTRAP_SECRETS=false
STARTUP_PREFLIGHT=warn
DEFAULT_TIMEZONE=America/Detroit
LOG_LEVEL=INFO

# Leave these blank on first container launch. They are generated once and stored
# with mode 0600 in /home/container/data/runtime.env.
ADMIN_TOKEN=
INTERNAL_TOKEN=
UPLOAD_TOKEN_SECRET=

# Embedded Asterisk and AVA
ASTERISK_MODE=embedded
AVA_ENABLED=true
SIP_TRUNK_MODE=disabled
SIP_PORT=5060
SIP_TLS_PORT=5061
RTP_START=10000
RTP_END=10040
PUBLIC_SIP_HOST=
PUBLIC_IP=
LOCAL_NET=172.16.0.0/12
ARI_PORT=8088
ARI_USERNAME=floodman-ava
ARI_SECRET=
AMI_PORT=5038
AMI_USERNAME=floodman
AMI_SECRET=
AMI_ENABLED=false
ASTERISK_TRUNK=floodman-trunk
SIP_CODECS=ulaw
GOOGLE_DIDS=

# Generic SIP carrier settings. Twilio uses the dedicated section below instead.
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
SIP_FROM_USER=
SIP_FROM_DOMAIN=
SIP_MATCH=
SIP_OUTBOUND_PROXY=

# Twilio Elastic SIP Trunk runtime settings. Provisioning API credentials
# live only in .env.twilio-provisioning. See docs/TWILIO_SETUP.md.
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TWILIO_PHONE_NUMBER=
TWILIO_FROM_NUMBER=
TWILIO_SECURE_TRUNKING=false
TWILIO_RTP_SYMMETRIC=false
# Override only after checking Twilio's current networking information.
TWILIO_SIGNALING_CIDRS=

# TLS/SRTP for the secure Twilio profile.
SIP_TLS_CERT_FILE=
SIP_TLS_KEY_FILE=
SIP_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
SIP_TLS_VERIFY_SERVER=true

# Human transfer and outbound identity numbers must use E.164 with a leading +.
FLOODMAN_LIVE_NUMBER=
FLOODMAN_EMERGENCY_NUMBER=
FLOODMAN_BILLING_NUMBER=
FLOODMAN_ESTIMATING_NUMBER=
OUTBOUND_CALLER_ID_NAME=Floodman
OUTBOUND_CALLER_ID_NUMBER=

# Controlled two-way echo tests. Keep disabled until the allowlist contains only
# operator-owned test phones.
TEST_CALLS_ENABLED=false
TEST_CALL_ALLOWLIST=
ENABLE_CARRIER_TEST_EXTENSIONS=false

# Google-aware call gate
GATE_ENABLED=true
GATE_HOST=0.0.0.0
GATE_PORT=9019
GATE_MIN_SECONDS=1.0
GATE_MAX_SECONDS=11.0
GATE_TRANSCRIBE_INTERVAL_SECONDS=1.8
GATE_NO_SPEECH_TIMEOUT_SECONDS=3.5
GATE_TRANSCRIBER=faster-whisper
FASTER_WHISPER_MODEL=tiny.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
GATE_STT_LANGUAGE=en
GATE_STT_URL=
GATE_STT_API_KEY=
GATE_STT_MODEL=tiny.en

# AVA pipeline
AVA_PROVIDER=local_hybrid
AVA_PIPELINE=local_hybrid
AVA_AUDIO_PROFILE=telephony_enhanced_8k
DEFAULT_PROVIDER=local_hybrid
ENABLE_LOCAL_AI_SERVER=true
AUTO_INSTALL_LOCAL_MODELS=false
LOCAL_MODEL_TIER=LIGHT
LOCAL_MODEL_LANGUAGE=en-US
RECONCILE_AVA_AGENTS=true

# Customer outreach remains disabled until consent, DNC, reassignment screening,
# caller ID, and Floodman's approved operating policy are configured.
OUTBOUND_ENABLED=false
OUTBOUND_CONCURRENCY=3
WORKER_POLL_SECONDS=2
DIALING_TIMEOUT_SECONDS=7200

# Roomflow remains optional during first telephone tests. Local records and a
# durable outbox keep the call workflow functioning while it is disabled.
ROOMFLOW_ENABLED=false
ROOMFLOW_BASE_URL=https://roomflow.example.com
ROOMFLOW_TOKEN=
ROOMFLOW_COMPANY_ID=
ROOMFLOW_VERIFY_TLS=true
ROOMFLOW_TIMEOUT_SECONDS=8
ROOMFLOW_SYNC_LOCAL_WRITES=true

# ── Call recording ─────────────────────────────────────────────────────────────
# Recording remains disabled by default until Floodman has configured and
# approved its disclosure policy.  Do not enable until legal review is complete.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_FORMAT=wav
CALL_RECORDING_BEEP_ENABLED=false

# When enabled, play a spoken disclosure before the substantive conversation.
# Set to false only when a confirmed carrier or Google disclosure already
# satisfies the configured recording policy.
CALL_RECORDING_DISCLOSURE_ENABLED=true
CALL_RECORDING_DISCLOSURE_MESSAGE=This call may be recorded for service and quality purposes.

# Number of days to retain recording files. Files under legal/operational hold
# are always preserved regardless of this value.
CALL_RECORDING_RETENTION_DAYS=90

# Include the transfer portion of the call in the same recording file.
CALL_RECORDING_INCLUDE_TRANSFERS=true

# Storage directory for recording files. This path is excluded from backups by
# default because recordings contain customer PII.
CALL_RECORDING_STORAGE_DIR=/home/container/data/recordings

# Floodman fast intake and team SMS routing.
# Comma-separated E.164 numbers. General numbers receive every intake;
# department lists receive only their matching intake.
FLOODMAN_TEAM_SMS_ENABLED=false
FLOODMAN_TEAM_ALERT_NUMBERS=
FLOODMAN_ESTIMATING_ALERT_NUMBERS=
FLOODMAN_EMERGENCY_ALERT_NUMBERS=
FLOODMAN_BILLING_ALERT_NUMBERS=
FLOODMAN_SUPPORT_ALERT_NUMBERS=
FLOODMAN_CALLBACK_SLA_HOURS=24
FLOODMAN_TEAM_SMS_TIMEOUT_SECONDS=8

# Twilio REST credentials for internal staff SMS. Prefer API key + secret.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
# Temporary fallback when an API key is unavailable:
TWILIO_AUTH_TOKEN=
# Configure one sender method:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=

# Balanced low-latency production voice settings.
DEEPGRAM_EOT_THRESHOLD=0.65
DEEPGRAM_EAGER_EOT_THRESHOLD=0.45
DEEPGRAM_EOT_TIMEOUT_MS=700
GROQ_LLM_TEMPERATURE=0.30
GROQ_LLM_TOP_P=0.70
GROQ_LLM_PRESENCE_PENALTY=0.2
GROQ_LLM_MAX_TOKENS=96
GROQ_LLM_TIMEOUT_SECONDS=8
GROQ_RATE_LIMIT_RETRIES=1
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=3
FLOODMAN_STREAMING_JITTER_BUFFER_MS=120
FLOODMAN_STREAMING_MIN_START_MS=40
FLOODMAN_STREAMING_GREETING_MIN_START_MS=30
FLOODMAN_STREAMING_LOW_WATERMARK_MS=60
FLOODMAN_STREAMING_PROVIDER_GRACE_MS=80
FLOODMAN_TTS_IDLE_CUTOFF_MS=300
