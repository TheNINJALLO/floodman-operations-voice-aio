# Initial Twilio test profile: SIP over UDP/RTP. Put the dashboard behind HTTPS.
APP_NAME=Floodman Operations Voice AIO
ENVIRONMENT=production
WEB_HOST=0.0.0.0
WEB_PORT=9000
# Docker publishes the dashboard only on loopback by default.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=9000
# Used by the optional docker-compose.caddy.yml HTTPS overlay.
VOICE_DOMAIN=voice.example.com
SIP_BIND_IP=0.0.0.0
PUBLIC_BASE_URL=https://voice.example.com
TRUSTED_HOSTS=voice.example.com,localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1
FORCE_HTTPS=false
ENABLE_API_DOCS=false
PRINT_BOOTSTRAP_SECRETS=false
STARTUP_PREFLIGHT=warn
DEFAULT_TIMEZONE=America/Detroit

ADMIN_TOKEN=
INTERNAL_TOKEN=
UPLOAD_TOKEN_SECRET=

ASTERISK_MODE=embedded
AVA_ENABLED=true
SIP_TRUNK_MODE=twilio
ASTERISK_TRUNK=floodman-trunk
SIP_PORT=5060
RTP_START=10000
RTP_END=10040
PUBLIC_SIP_HOST=
PUBLIC_IP=203.0.113.10
LOCAL_NET=172.16.0.0/12
SIP_CODECS=ulaw
ARI_USERNAME=floodman-ava
ARI_SECRET=
AMI_USERNAME=floodman
AMI_SECRET=
AMI_ENABLED=true

# Runtime Twilio SIP settings. Account API credentials belong only in
# .env.twilio-provisioning and are never required by the running service.
TWILIO_TERMINATION_URI=floodman-unique-name.pstn.ashburn.twilio.com
TWILIO_SIP_USERNAME=FloodmanAsterisk1
TWILIO_SIP_PASSWORD=ReplaceWithMixedCase12345
TWILIO_PHONE_NUMBER=+12315551234
TWILIO_FROM_NUMBER=+12315551234
TWILIO_SECURE_TRUNKING=false
TWILIO_RTP_SYMMETRIC=false

OUTBOUND_CALLER_ID_NAME=Floodman
OUTBOUND_CALLER_ID_NUMBER=+12315551234
FLOODMAN_LIVE_NUMBER=+12315550001
FLOODMAN_EMERGENCY_NUMBER=+12315550002
FLOODMAN_BILLING_NUMBER=+12315550003
FLOODMAN_ESTIMATING_NUMBER=+12315550004
GOOGLE_DIDS=+12315551234

# Replace with an operator-owned mobile number before enabling.
TEST_CALLS_ENABLED=false
TEST_CALL_ALLOWLIST=+12315559876
ENABLE_CARRIER_TEST_EXTENSIONS=false

GATE_ENABLED=true
GATE_PORT=9019
GATE_NO_SPEECH_TIMEOUT_SECONDS=3.5
GATE_TRANSCRIBER=faster-whisper
FASTER_WHISPER_MODEL=tiny.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
AVA_PROVIDER=local_hybrid
AVA_PIPELINE=local_hybrid
AVA_AUDIO_PROFILE=telephony_enhanced_8k
DEFAULT_PROVIDER=local_hybrid
ENABLE_LOCAL_AI_SERVER=true
AUTO_INSTALL_LOCAL_MODELS=false
RECONCILE_AVA_AGENTS=true

OUTBOUND_ENABLED=false
ROOMFLOW_ENABLED=false

# Production conversational AI profile.
# Keep keys private in Pterodactyl Startup or data/runtime.env.
FLOODMAN_AI_PROFILE=auto
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_FLUX_MODEL=flux-general-en
DEEPGRAM_EOT_TIMEOUT_MS=1200
GROQ_LLM_MODEL=qwen/qwen3.6-27b
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Cloud provider startup safety.
FLOODMAN_PRODUCTION_STRICT=false
FLOODMAN_CLOUD_AUDIO_PROBE=true
FLOODMAN_KEEP_LOCAL_FALLBACK_WARM=false

# Suppress routine rejected SIP scanner NOTICE lines from the console.
# Full NOTICE details remain in data/asterisk/logs/full.
ASTERISK_CONSOLE_LEVELS=warning,error,verbose

# Internal Asterisk <-> Ava media path for production modular pipelines.
# These loopback UDP ports are separate from Twilio's public RTP range.
FLOODMAN_EXTERNALMEDIA_RTP_HOST=127.0.0.1
FLOODMAN_EXTERNALMEDIA_ADVERTISE_HOST=127.0.0.1
FLOODMAN_EXTERNALMEDIA_RTP_PORT=18080
FLOODMAN_EXTERNALMEDIA_PORT_RANGE=18080:18099
