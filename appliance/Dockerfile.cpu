ARG LLAMA_CPP_COMMIT=6d05498314db1b57f81c271080018aa2d0b89be9
ARG TEL_AGENT_COMMIT=8a5193b2d801714e45ae6981a3506a60d562a99e

FROM ubuntu:24.04 AS llama-build
ARG LLAMA_CPP_COMMIT
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git cmake build-essential libssl-dev libcurl4-openssl-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init llama.cpp && \
    git -C llama.cpp remote add origin https://github.com/ggml-org/llama.cpp.git && \
    git -C llama.cpp fetch --depth 1 origin "${LLAMA_CPP_COMMIT}" && \
    git -C llama.cpp checkout --detach FETCH_HEAD && \
    cmake -S llama.cpp -B build \
      -DGGML_NATIVE=OFF -DGGML_CUDA=OFF -DGGML_BACKEND_DL=ON \
      -DGGML_CPU_ALL_VARIANTS=ON -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_EXAMPLES=OFF -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --target llama-server -j2 && \
    mkdir -p /out/bin /out/lib && \
    cp build/bin/llama-server /out/bin/ && \
    find build -name '*.so*' -exec cp -P {} /out/lib/ \;

FROM ubuntu:24.04
ARG CONTAINER_UID=988
ARG CONTAINER_GID=988
ARG TEL_AGENT_COMMIT
ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    WEB_PORT=8002 LOCAL_AI_DEVICE=cpu LOCAL_AI_ONLY=true \
    HOME=/home/container \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    LD_LIBRARY_PATH=/opt/llama
RUN apt-get update && apt-get install -y --no-install-recommends \
    asterisk supervisor python3 python3-pip python3-venv \
    curl ca-certificates ffmpeg espeak-ng libsndfile1 libgomp1 libcurl4t64 git && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/share/asterisk/sounds/en && \
    espeak-ng -s 155 -v en-us -w /tmp/floodman-technical-failure-source.wav \
      "We're having a temporary technical issue. I've alerted the Floodman team. Please expect a callback as soon as possible." && \
    ffmpeg -hide_banner -loglevel error -y \
      -i /tmp/floodman-technical-failure-source.wav -ar 8000 -ac 1 -c:a pcm_s16le \
      /usr/share/asterisk/sounds/en/floodman-technical-failure.wav && \
    rm -f /tmp/floodman-technical-failure-source.wav
RUN groupadd --gid "${CONTAINER_GID}" container && \
    useradd --uid "${CONTAINER_UID}" --gid "${CONTAINER_GID}" \
      --create-home --home-dir /home/container --shell /bin/bash container
COPY --from=llama-build /out/bin/llama-server /opt/llama/llama-server
COPY --from=llama-build /out/lib/ /opt/llama/
WORKDIR /opt/floodman
COPY pyproject.toml ./
COPY app ./app
COPY scripts ./scripts
COPY config ./config
COPY knowledge ./knowledge
COPY templates ./templates
COPY static ./static
COPY supervisor ./supervisor
COPY THIRD_PARTY_LICENSES.md README.md ./
RUN git init /opt/tel-agent && \
    git -C /opt/tel-agent remote add origin https://github.com/Dpro-at/Tel-Agent.git && \
    git -C /opt/tel-agent fetch --depth 1 origin "${TEL_AGENT_COMMIT}" && \
    git -C /opt/tel-agent checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/tel-agent rev-parse HEAD)" = "${TEL_AGENT_COMMIT}" && \
    grep -q "GNU AFFERO GENERAL PUBLIC LICENSE" /opt/tel-agent/LICENSE
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel && \
    /opt/venv/bin/pip install . && \
    PYTHONPATH=/opt/tel-agent /opt/venv/bin/python -c "from agent.providers.llm.openai_compatible import OpenAICompatibleLLM; from agent.session.turn import speak; assert OpenAICompatibleLLM and speak" && \
    /opt/venv/bin/python -c "import app, yaml, asyncio; assert hasattr(asyncio, 'timeout')" && \
    mkdir -p /home/container/data && \
    chown -R container:container /home/container /opt/floodman /opt/llama /opt/tel-agent && \
    chmod +x /opt/floodman/scripts/*.sh /opt/floodman/scripts/*.py
USER container
WORKDIR /home/container
EXPOSE 8002/tcp 5060/udp 5060/tcp 10000-10100/udp
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 CMD curl -fsS "http://127.0.0.1:${WEB_PORT}/ready" || exit 1
ENTRYPOINT ["/opt/floodman/scripts/entrypoint.sh"]
