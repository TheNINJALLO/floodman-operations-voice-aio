# Use a separate DATA_DIR and test phone route until carrier acceptance passes.
LOCAL_VOICE_STACK=streaming_trial
PRIMARY_MODEL_PROFILE=haiku8b
VOICE_ENGINE=tel_agent
LOCAL_AI_ONLY=true
LOCAL_AI_DEVICE=cpu
LLAMA_THREADS=4
LLAMA_BATCH_THREADS=4
LLAMA_CONTEXT_SIZE=4096
SHERPA_THREADS=2
SHERPA_WHISPER_FALLBACK=true
POCKET_THREADS=2
POCKET_VOICE=alba
POCKET_SPEED=1.0
SILERO_THRESHOLD=0.5
BARGE_IN_MIN_SPEECH_MS=320
BARGE_IN_ENERGY_THRESHOLD=500
BARGE_IN_VAD_THRESHOLD=0.75
BARGE_IN_MAX_GAP_MS=60
BARGE_IN_ECHO_SUPPRESSION=true
BARGE_IN_RESUME_MS=800
CONVERSATION_ENDPOINT_SILENCE_MS=600
CONTACT_ENDPOINT_SILENCE_MS=650
EMAIL_ENDPOINT_SILENCE_MS=1600
# The same-host CPU comparison missed the complete-rewrite latency budget.
# Keep routine replies immediate; model-backed approved answers still use 8B.
TEL_AGENT_NATURALIZE=false
TEL_AGENT_WORDING_BUDGET_MS=1200
# Optional second local model for background drafts on the 64+ GB server.
# Set both switches true together after the isolated speech trial is accepted.
LOCAL_DECKARD_BRIEFINGS=false
POST_CALL_BRIEFINGS_ENABLED=false
BRIEFING_BACKEND=local_api
BRIEFING_MODEL=floodman-deckard:40b-q4_k_m
BRIEFING_LLAMA_URL=http://127.0.0.1:8082/v1
BRIEFING_THREADS=4
BRIEFING_TIMEOUT_SECONDS=300
