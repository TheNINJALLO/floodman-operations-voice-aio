# Floodman Voice Appliance
DATA_DIR=/home/container/data
PUBLIC_BASE_URL=http://127.0.0.1:8002
TRUSTED_HOSTS=localhost,127.0.0.1
ADMIN_TOKEN=
INTERNAL_TOKEN=
SESSION_HOURS=12
WEB_PUSH_SUBJECT=mailto:notifications@oninetwork.com

# CPU local LLM. Set LOCAL_AI_DEVICE=cuda explicitly for the earlier A1000 host.
LOCAL_AI_DEVICE=cpu
LOCAL_AI_ONLY=true
PRIMARY_MODEL_PROFILE=deckard
# Optional path to the verified Deckard GGUF already installed on this server.
# Otherwise startup downloads the pinned file under DATA_DIR/models/llm.
DECKARD_MODEL_PATH=
# PRIMARY_MODEL_PROFILE=custom requires explicit LLAMA_MODEL_REPO,
# LLAMA_MODEL_FILENAME and LLAMA_MODEL_ALIAS. There is no automatic Qwen fallback.
LLAMA_CONTEXT_SIZE=4096
# Applied only in CUDA mode; CPU mode always uses zero GPU layers.
LLAMA_GPU_LAYERS=99
LLAMA_THREADS=6
LLAMA_BATCH_THREADS=6
LLAMA_TIMEOUT_SECONDS=2
LLAMA_API_KEY=floodman-local
HF_TOKEN=

# Local speech and voice
VOICE_ENGINE=tel_agent
TEL_AGENT_WORDING_BUDGET_MS=1200
# Ignored while LOCAL_AI_ONLY=true. Optional cloud providers require an
# explicit LOCAL_AI_ONLY=false in addition to provider credentials.
DEEPGRAM_API_KEY=
TEL_AGENT_DEEPGRAM_MODEL=nova-3
TEL_AGENT_ENDPOINTING_MS=450
TEL_AGENT_UTTERANCE_END_MS=1000
TEL_AGENT_NATURALIZE=true
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.6-27b
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
FASTER_WHISPER_MODEL=small.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_THREADS=4
KOKORO_THREADS=2
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.90
EMAIL_READBACK_SPEED=0.78
# The admin portal persists its override to DATA_DIR/voice-settings.json.
ENDPOINT_SILENCE_MS=400
CONTACT_ENDPOINT_SILENCE_MS=800
EMAIL_ENDPOINT_SILENCE_MS=1600
NO_INPUT_TIMEOUT_SECONDS=12
INPUT_PREROLL_MS=240
# Marks slow replies in diagnostics; never changes call routing or speech.
CALL_SLOW_RESPONSE_MS=2000

# Drafts reuse the resident primary Deckard by default. The optional Ollama
# backend remains available for an explicitly separate private model service.
POST_CALL_BRIEFINGS_ENABLED=false
BRIEFING_BACKEND=primary
BRIEFING_OLLAMA_URL=http://127.0.0.1:11434
BRIEFING_MODEL=floodman-deckard:40b-q4_k_m
BRIEFING_THREADS=4
BRIEFING_TIMEOUT_SECONDS=120
POST_TTS_GUARD_MS=120
VAD_ENERGY_THRESHOLD=325
BARGE_IN_ENABLED=true
BARGE_IN_MIN_SPEECH_MS=160
BARGE_IN_ENERGY_THRESHOLD=325
BARGE_IN_PREROLL_MS=240

# SIP carrier
SIP_MODE=twilio
SIP_SERVER=
SIP_PORT=5060
SIP_TRANSPORT=udp
# TLS requires a certificate and matching private key in DATA_DIR/asterisk/keys,
# or explicit SIP_TLS_CERT_FILE / SIP_TLS_KEY_FILE paths. TLS also enables SRTP.
SIP_USERNAME=
SIP_PASSWORD=
SIP_FROM_USER=
SIP_FROM_DOMAIN=
SIP_MATCH_ADDRESSES=54.172.60.0/30,54.244.51.0/30,54.171.127.192/30,35.156.191.128/30,54.65.63.192/30,54.169.127.128/30,54.252.254.64/30,177.71.206.192/30
SIP_OUTBOUND_PROXY=
SIP_LOCAL_NET=172.16.0.0/12
PUBLIC_IP=
TWILIO_PHONE_NUMBER=
OUTBOUND_CALLER_ID_NUMBER=
FLOODMAN_LIVE_NUMBER=
FLOODMAN_EMERGENCY_NUMBER=
FLOODMAN_BILLING_NUMBER=
FLOODMAN_ESTIMATING_NUMBER=

# Team SMS, still uses the phone carrier rather than an AI provider
FLOODMAN_TEAM_SMS_ENABLED=true
FLOODMAN_TEAM_ALERT_NUMBERS=
FLOODMAN_ESTIMATING_ALERT_NUMBERS=
FLOODMAN_EMERGENCY_ALERT_NUMBERS=
FLOODMAN_BILLING_ALERT_NUMBERS=
FLOODMAN_SUPPORT_ALERT_NUMBERS=
FLOODMAN_CALLBACK_SLA_HOURS=24
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=

# Permission-scoped team email. These values bootstrap the persistent
# email-settings.json file; administrators can configure SMTP in the web panel.
FLOODMAN_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Floodman Call Center
SMTP_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
