# The tested production CPU runtime supplies Asterisk, ffmpeg and llama.cpp.
# Model weights are downloaded to DATA_DIR, never baked into this image.
FROM ghcr.io/theninjallo/floodman-operations-voice-aio@sha256:803042d29d2e427c97e1511c1715e35b9cdd6f25d62275f33516e091b03911cb
USER root
WORKDIR /opt/floodman
COPY pyproject.toml ./
COPY app ./app
COPY scripts ./scripts
COPY config ./config
COPY templates ./templates
COPY supervisor ./supervisor
COPY THIRD_PARTY_LICENSES.md README.md ./
RUN /opt/venv/bin/pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu && \
    /opt/venv/bin/pip install '.[streaming_trial]' && \
    chmod +x /opt/floodman/scripts/*.sh /opt/floodman/scripts/*.py
ENV LOCAL_VOICE_STACK=streaming_trial PRIMARY_MODEL_PROFILE=haiku8b \
    LOCAL_AI_ONLY=true LOCAL_AI_DEVICE=cpu VOICE_ENGINE=tel_agent \
    LOCAL_DECKARD_BRIEFINGS=false POCKET_THREADS=2 SHERPA_THREADS=2 \
    POCKET_VOICE=alba POCKET_SPEED=1.0 LLAMA_THREADS=4 LLAMA_BATCH_THREADS=4
USER container
WORKDIR /home/container
