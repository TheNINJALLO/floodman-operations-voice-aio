# One-time Twilio provisioning credentials for scripts/twilio_bootstrap.py.
# Copy to .env.twilio-provisioning, chmod 600, and never mount it into the
# long-running voice container. Prefer a restricted Twilio API key.
TWILIO_API_REGION=us1
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_KEY_SECRET=replace-with-api-key-secret
# Temporary fallback only when an API key is unavailable:
TWILIO_AUTH_TOKEN=

# The domain must be globally unique in Twilio and match TWILIO_TERMINATION_URI
# in the runtime .env file.
TWILIO_TRUNK_FRIENDLY_NAME=Floodman Operations Voice
TWILIO_TRUNK_DOMAIN=floodman-unique-name.pstn.twilio.com
TWILIO_ORIGINATION_FRIENDLY_NAME=Floodman Primary Asterisk
# Use the same globally routable IP or FQDN configured as PUBLIC_IP/PUBLIC_SIP_HOST.
TWILIO_ORIGINATION_SIP_URI=sip:203.0.113.10:5060;edge=ashburn
TWILIO_ORIGINATION_PRIORITY=10
TWILIO_ORIGINATION_WEIGHT=10
TWILIO_TRANSFER_MODE=disable-all

# Optional existing resource SIDs. Leave blank for idempotent name/domain lookup.
TWILIO_TRUNK_SID=
TWILIO_CREDENTIAL_LIST_SID=
TWILIO_CREDENTIAL_SID=
TWILIO_ORIGINATION_URL_SID=
TWILIO_PHONE_NUMBER_SID=
TWILIO_ALLOW_PHONE_ROUTING_CHANGE=false

# Existing SIP passwords cannot be read back from Twilio. Keep false during
# ordinary verification and set true only for an intentional credential rotation.
TWILIO_ROTATE_SIP_PASSWORD_ON_APPLY=false
TWILIO_BOOTSTRAP_STATE=./data/twilio/provisioning.json
